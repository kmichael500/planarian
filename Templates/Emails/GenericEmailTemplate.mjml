<mjml lang="en">
  <mj-head>
    <mj-title>Planarian</mj-title>
    <mj-preview>{{previewText}}</mj-preview>
    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" />
      <mj-body background-color="#f4f6f4" width="600px" />
      <mj-section padding="0" />
      <mj-column padding="0" />
      <mj-text color="#24342e" font-size="16px" line-height="26px" padding="0" />
      <mj-button font-size="16px" font-weight="700" line-height="22px" />
    </mj-attributes>
    <mj-style inline="inline">
      .email-link { color: #175c7c; text-decoration: underline; }
      .footer-link { color: #4c6055; text-decoration: underline; }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f4f6f4">
    <mj-section padding="28px 20px 0">
      <mj-column>
        <mj-spacer height="1px" padding="0" />
      </mj-column>
    </mj-section>

    <mj-wrapper background-color="#ffffff" border="1px solid #dfe6e1" border-radius="10px" padding="0">
      <mj-section background-color="#ffffff" padding="32px 38px 0">
        <mj-column>
          <mj-text font-size="17px" line-height="40px" font-weight="700" color="#244939">
            <img src="https://saplanarian.blob.core.windows.net/public/planarianLogo.png" alt="" width="36" height="36" style="vertical-align:middle; border:0;" />
            <span style="vertical-align:middle; padding-left:8px;">Planarian</span>
          </mj-text>
        </mj-column>
      </mj-section>

      <mj-section background-color="#ffffff" padding="28px 38px 12px">
        <mj-column>
          <mj-divider border-color="#e5bd49" border-width="3px" width="44px" align="left" padding="0 0 24px" />
          <mj-text padding="0" color="#172921">
            <h1 style="margin:0; font-family:Arial, Helvetica, sans-serif; font-size:27px; font-weight:700; line-height:34px; color:#172921;">{{header}}</h1>
          </mj-text>
        </mj-column>
      </mj-section>

      <mj-section background-color="#ffffff" padding="12px 38px 4px">
        <mj-column>
          <mj-raw>{{#each messages}}</mj-raw>
          <mj-text padding="0 0 17px">
            <p style="margin:0;">{{this}}</p>
          </mj-text>
          <mj-raw>{{/each}}</mj-raw>
        </mj-column>
      </mj-section>

      <mj-raw>{{#if buttonText}}</mj-raw>
      <mj-section background-color="#ffffff" padding="5px 38px 24px">
        <mj-column>
          <mj-button
            href="{{buttonUrl}}"
            align="left"
            background-color="#165f7f"
            color="#ffffff"
            border-radius="6px"
            inner-padding="15px 24px"
            padding="0"
          >
            {{buttonText}}
          </mj-button>
          <mj-text color="#52655a" font-size="13px" line-height="20px" padding="21px 0 0">
            If the button doesn't work, open this link in your browser:<br />
            <a class="email-link" href="{{buttonUrl}}" style="word-break:break-all;">{{buttonUrl}}</a>
          </mj-text>
        </mj-column>
      </mj-section>
      <mj-raw>{{/if}}</mj-raw>

      <mj-section background-color="#ffffff" padding="10px 38px 32px">
        <mj-column>
          <mj-divider border-color="#e2e9e4" border-width="1px" padding="0 0 18px" />
          <mj-text color="#52655a" font-size="13px" line-height="21px">
            This message was sent by Planarian.
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <mj-section padding="20px 24px 36px">
      <mj-column>
        <mj-text align="center" color="#4c6055" font-size="13px" line-height="20px">
          <a class="footer-link" href="{{websiteUrl}}">Visit Planarian</a>
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
