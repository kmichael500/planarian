{
  "routes": {
    "invitationList": {
      "path": "/user/invitations"
    },
    "invitation": {
      "path": "/user/invitations/:invitationCode"
    },
    "emailConfirmation": {
      "path": "/confirm-email",
      "queryParameters": [
        "code"
      ]
    },
    "emailConfirmationPending": {
      "path": "/confirm-email/pending"
    },
    "passwordReset": {
      "path": "/reset-password",
      "queryParameters": [
        "code"
      ]
    },
    "caveChanges": {
      "path": "/caves/changes"
    },
    "caveChangeRequest": {
      "path": "/caves/requests/:requestId"
    },
    "caveChangeRequestRevise": {
      "path": "/caves/requests/:requestId/revise"
    }
  }
}
