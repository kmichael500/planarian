    {
      "id": "case-insensitive-tag-creation-deduplication",
      "baselineCommit": "11cdd9edc58d85bcf14a9d82c797f715d3a0e2ae",
      "affectedAreas": ["Cave tag imports", "Entrance tag imports"],
      "historicalBehavior": "Tag creation and requested-name deduplication were case-sensitive even though association resolution was case-insensitive.",
      "targetBehavior": "Trimmed tag names are matched and deduplicated case-insensitively within each tag key, preserving an eligible existing tag's ID and canonical name.",
      "rationale": "The baseline creation check was inconsistent with its own case-insensitive resolution and could persist unused case-only duplicates."
    }
  ],
