  "scripts": {
    "prepare:client-routes": "npm run test:client-routes-generator && npm run generate:client-routes",
    "generate:client-routes": "node ../scripts/generate-client-routes.mjs",
    "test:client-routes-generator": "node --test ../scripts/generate-client-routes.test.mjs",
    "check:client-routes": "npm run test:client-routes-generator && node ../scripts/generate-client-routes.mjs --check",
    "test:csp-config": "node --test ../scripts/configure-static-web-app-csp.test.mjs",
    "prestart": "npm run prepare:client-routes",
    "start": "react-scripts start",
    "prebuild": "npm run prepare:client-routes && npm run test:csp-config",
    "build": "CI=false react-scripts build",
    "postbuild": "node ../scripts/configure-static-web-app-csp.mjs",
    "pretest": "npm run prepare:client-routes && npm run test:csp-config",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "predeploy": "npm run build",
    "deploy": "swa deploy --env production"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not ie 11",
      "not chrome < 51",
      "not safari < 10",
      "not android < 51"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@azure/static-web-apps-cli": "^1.1.4",
    "@types/react-highlight-words": "^0.16.4",
    "@types/react-text-mask": "^5.4.11",
